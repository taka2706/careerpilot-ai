APP_NAME=CareerPilot AI
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./careerpilot.db

# Optional until the LLM workflow is introduced in Phase 4.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

MAX_AGENT_RETRIES=2
LLM_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=5

# Used by the Streamlit process, and independently overrideable from the API settings.
CAREERPILOT_API_URL=http://localhost:8000
